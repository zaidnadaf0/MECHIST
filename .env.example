# Firebase Web App config (provided in Firebase Console > Project settings > General)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Maps provider: leaflet (OSM, default) or geoapify (requires VITE_GEOAPIFY_API_KEY)
VITE_MAPS_PROVIDER=leaflet

# Geoapify API key (browser-exposed). Get one at https://myprojects.geoapify.com
# Leave as placeholder until you have a real key — the app falls back to Leaflet/OSM when missing.
VITE_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

# Python ML ranking service (FastAPI: ml/api/main.py, POST /rank-mechanics).
# Local dev default is http://localhost:8000 — set this for staging/prod.
# When unset or unreachable the app falls back to the deterministic
# baseline ranker in src/lib/mlRank.ts (no crash, no fake ML scores).
# VITE_ML_API_URL=http://localhost:8000
